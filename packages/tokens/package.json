    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/acosta290/fluvy/issues"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./runtime": "./src/runtime.ts",
    "./community": "./src/palettes/community/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && tsx scripts/community.ts && tsx src/build/run.ts",
