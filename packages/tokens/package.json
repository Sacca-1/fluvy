{
  "name": "@fluvy/tokens",
  "version": "1.7.0",
  "private": true,
  "description": "Design tokens for the Fluvy theme: OKLCH derivation, palettes, CSS/JSON emitters",
  "license": "GPL-3.0-only",
  "author": {
    "name": "acosta290",
    "url": "https://github.com/acosta290"
  },
  "homepage": "https://github.com/acosta290/fluvy#readme",
  "repository": {
