{
  "name": "fluvy",
  "version": "1.7.0",
  "private": true,
  "description": "A calm theme and card library for Home Assistant: a generated light and dark theme, fifty cards, five automatic dashboards and a settings panel, installed through HACS",
  "license": "GPL-3.0-only",
  "author": {
    "name": "acosta290",
    "url": "https://github.com/acosta290"
  },
  "homepage": "https://github.com/acosta290/fluvy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acosta290/fluvy.git"
  },
  "bugs": {
    "url": "https://github.com/acosta290/fluvy/issues"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "pnpm --filter @fluvy/tokens build && pnpm --filter @fluvy/theme build && pnpm --filter @fluvy/ui build:styles && pnpm --filter @fluvy/i18n build && pnpm --filter @fluvy/bundle build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm --filter @fluvy/i18n check && pnpm --filter @fluvy/docs check && node tools/release/check.mjs",
    "visual": "node tools/render/visual.mjs",
    "clips": "node tools/render/clip.mjs",
    "i18n": "pnpm --filter @fluvy/i18n check",
    "render": "pnpm --filter @fluvy/render render",
    "contact-sheet": "pnpm --filter @fluvy/render contact-sheet",
    "brand": "node tools/brand/render-brand.mjs",
    "leak-scan": "bash tools/release/leak-scan.sh",
    "release:version": "node tools/release/version.mjs",
    "release:check": "node tools/release/check.mjs --release",
    "ha:install": "node tools/dev/install.mjs",
    "measure": "node tools/render/measure-all.mjs",
    "docs:cards": "pnpm --filter @fluvy/docs build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mdi/js": "7.4.47",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
